SELECT products.name, products_detail.description FROM products 
INNER JOIN products_detail on products.product_id = products_detail.product_id;

SELECT * FROM products 
LEFT JOIN products_detail on products.product_id = products_detail.product_id;

SELECT * FROM products 
RIGHT JOIN products_detail on products.product_id = products_detail.product_id;


SELECT * FROM products 
FULL JOIN products_detail on products.product_id = products_detail.product_id;


SELECT p.name, p.photo, p.price, p.product_id, pd.category, pd.color, pd.description
FROM products p
INNER JOIN products_detail pd on p.product_id = pd.product_id;


